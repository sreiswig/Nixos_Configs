  xdg.dataFile."remmina/group_rdp_ai-server_aiserver-tail93ec7d-ts-net.remmina".text = ''
    [remmina]
    protocol=RDP
    name=AI Server
    group=Homelab
    server=aiserver.tail93ec7d.ts.net
    username=sam
    ignore-tls-errors=1
    cert_ignore=1
    security=tls
    colordepth=32
    quality=9
    resolution_mode=2
    window_maximize=1
    sound=off
    disableclipboard=0
    network=lan
    preferipv6=0
    gateway_usage=0
    disablepasswordstoring=0
  '';

